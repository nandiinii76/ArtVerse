# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# --- Database ---
DB_NAME=artverse
DB_USERNAME=artverse
DB_PASSWORD=change-me

# --- Backend ---
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Media storage ---
# Use local for development or cloudinary for production-style cloud image hosting.
MEDIA_PROVIDER=local
MEDIA_STORAGE_DIR=./data/media
# When MEDIA_PROVIDER=cloudinary, provide the Cloudinary connection URL in your local .env.
CLOUDINARY_URL=

# --- Frontend ---
VITE_API_URL=http://localhost:8080/api/v1
