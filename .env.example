# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# --- Database ---
DB_NAME=artverse
DB_USERNAME=artverse
DB_PASSWORD=change-me

# --- Backend ---
# Must be a long, random string (32+ chars) in any real environment.
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8080/api/v1
